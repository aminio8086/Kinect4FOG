<Window x:Class="Parkinson.Detection.SerialPortSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serial Port Settings" Closing="SerialPortSettingsWindow_Closing" Height="241.202" Width="277">
    <Grid Background="#FFF1F1F1">
        <Border BorderBrush="#FF939393" BorderThickness="1" HorizontalAlignment="Left" Height="144" Margin="124,63,0,0" VerticalAlignment="Top" Width="83"/>

        <ListBox x:Name="List_com" HorizontalAlignment="Left" Height="144" Margin="15,63,0,0" VerticalAlignment="Top" Width="83"/>
        <Button x:Name="B_save" Content="Save" HorizontalAlignment="Left" Margin="128,168,0,0" VerticalAlignment="Top" Width="75" Click="B_save_Click"/>
        <Button x:Name="B_scan" Content="Scan" HorizontalAlignment="Left" Margin="128,83,0,0" VerticalAlignment="Top" Width="75" Click="B_scan_Click"/>
        <Slider x:Name="servoa" HorizontalAlignment="Left" Height="18" Margin="10,10,0,0" VerticalAlignment="Top" Width="249" Maximum="156" Minimum="23" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1"/>

    </Grid>
</Window>
