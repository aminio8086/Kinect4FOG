<Window x:Class="Parkinson.Detection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinect4FOG" 
        Height="479.602" Width="772.155" 
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing" ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="MediumGreyBrush" Color="#ff6e6e6e" />
        <SolidColorBrush x:Key="KinectPurpleBrush" Color="#ff52318f" />
        <SolidColorBrush x:Key="KinectBlueBrush" Color="#ff00BCF2" />
    </Window.Resources>
    <Grid Margin="0,0,-1,0" Background="#FFF1F1F1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="52.8" />
            <RowDefinition Height="648*" />
            <RowDefinition Height="8*"/>
            <RowDefinition Height="41*"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="388" Margin="10,25,0,0" VerticalAlignment="Top" Width="723" Grid.RowSpan="2"/>

        <Image x:Name="Image" HorizontalAlignment="Left" Height="360" Margin="46,0,0,22" VerticalAlignment="Bottom" Width="640" Stretch="Fill" Grid.Row="1"/>
        <Canvas x:Name="canvas" HorizontalAlignment="Left" Height="360" Margin="46,0,0,22" VerticalAlignment="Bottom" Width="640" Grid.RowSpan="2"/>
        <Ellipse x:Name="box" Fill="Red" HorizontalAlignment="Left" Height="49" Margin="765,3.2,0,-11.4" Stroke="Black" VerticalAlignment="Top" Width="55" Grid.Row="3" Visibility="Hidden" Grid.RowSpan="2"/>
        <Menu DockPanel.Dock="Top" Margin="10,0,36,33">
            <MenuItem Header="View">

                <MenuItem Header="Data Window" HorizontalAlignment="Left" Width="277" Click="Menu_DataWindow_Click" Margin="0,0,-1.667,0"/>

            </MenuItem>

            <MenuItem Header="Tools">

                <MenuItem Header="COM Settings" HorizontalAlignment="Left" Width="275" Click="Menu_COMSetting_Click"/>
                <MenuItem Header="Broadcast" HorizontalAlignment="Left" Width="275" Click="Menu_Broadcast_Click"/>
            </MenuItem>
        </Menu>

    </Grid>
</Window>
